# Secrets and local configuration (keep example files trackable)
.env
.env.*
!.env.example
!.env.sample

# Python virtual environments and generated bytecode
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

# Test, analysis and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# JavaScript dependencies, package-manager caches and build output
node_modules/
.npm/
.pnpm-store/
build/
dist/
*.egg-info/

# Dashboard runtime state and SQLite database/sidecar files
/runtime/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Generated logs and OS/editor temporary files
*.log
*.log.*
/logs/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
